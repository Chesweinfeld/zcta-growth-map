{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://chesweinfeld.github.io",
          "http://localhost:8787"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["range", "if-match"]
      },
      "exposeHeaders": ["content-range", "content-length", "etag"],
      "maxAgeSeconds": 86400
    }
  ]
}
